# INERT TEMPLATE: review paths/config/key custody/window before installing.
[Unit]
Description=WashFlow paired encrypted offsite backup
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=REPLACE_WITH_APPROVED_OPERATOR
UMask=0077
ExecStart=/usr/bin/python3 -B /APPROVED/scripts/backup/scheduled.py --config /PRIVATE/backup.json --approve-capture /opt/washflow
# Ordinary TERM enters bounded recovery; a second TERM cannot interrupt its finally.
# KillMode=process avoids systemd killing the recovery children simultaneously.
KillMode=process
TimeoutStartSec=3h
TimeoutStopSec=6min
# SIGKILL/reboot needs the runbook's exact-ID node-only recovery, not an auto-restart.
Restart=no

[Install]
WantedBy=multi-user.target
